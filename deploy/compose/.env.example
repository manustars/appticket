# The install's settings: copy this file to .env beside compose.yaml and set the values.
# A line that starts with # is not set. Put a value that holds $, # or a space in single quotes:
# Compose reads $ as the start of a variable.

# What runs beside the core, separated by commas (compose.yaml describes them): db (the bundled
# PostgreSQL, with its dumps), dumps (the dumps of an existing database), assistant (the
# Assistant), greenmail (a test mail server), https (Caddy, for a host with no reverse proxy).
# Leave db out to use an existing database.
COMPOSE_PROFILES=db

# The version of the images. A release's compose.yaml names its own version and does not read
# this line, so that the next release's files run the next version with the same .env; only the
# compose.yaml of the source repository, which names none, reads it.
#HD_VERSION=0.4.0

# The address agents open the help desk at, through the reverse proxy in front of the core.
HD_PUBLIC_URL=https://helpdesk.example.com

# Where the core is published on this host, for that proxy: the address (the loopback address
# by default) and the port. reverse-proxy.md says what the proxy does, with examples.
#HD_HTTP_ADDRESS=127.0.0.1
HD_HTTP_PORT=8080

# The network of the install's containers: the proxy on this host reaches the core from its
# first address. Change it when it overlaps a network that this host reaches, such as another
# install's on this host or a LAN or VPN that the database, the mail server or the identity
# provider is on; then run `docker compose down` and `docker compose up -d` (reverse-proxy.md).
#HD_SUBNET=172.16.0.0/24

# The reverse proxies whose X-Forwarded-For the core believes, as addresses or networks
# separated by commas: HD_SUBNET unless set here, which holds the address the proxy on this host
# connects from and Caddy's, but also every container of the install and every process of this
# host that connects to the core's port (reverse-proxy.md). Empty, the core believes none: set
# it so, or to the proxy's address alone, when the core's port is open to other hosts
# (HD_HTTP_ADDRESS).
#HD_TRUSTED_PROXIES=172.16.0.0/24

# The profile https: Caddy in front of the core, for a host with no reverse proxy, on the ports
# 80 and 443 of every address of the host (others here, for a host that cannot open those). It
# serves HD_PUBLIC_URL, which then names no path, with the certificate set here:
#   acme      from Let's Encrypt, for its host name, which leads to this host from the Internet
#   files     one's own, secrets/tls_certificate (with its chain) and secrets/tls_key, named in
#             the two HD_SECRET_TLS_* lines below
#   internal  from Caddy's own authority, for a LAN or a trial: reverse-proxy.md says how to get
#             its root certificate for the browsers
#HD_HTTPS_CERTIFICATE=acme
#HD_SECRET_TLS_CERTIFICATE=./secrets/tls_certificate
#HD_SECRET_TLS_KEY=./secrets/tls_key
#HD_CADDY_HTTP_PORT=80
#HD_CADDY_HTTPS_PORT=443

# The database (docs/external-database.md describes each setting). Its password is not set
# here: it is the file secrets/db_password (secrets/README.md).
#
# With the profile db, keep the host, name, user and mode below, and write the password once,
# before the first start, with `chmod 700 secrets` and then `docker compose run --rm
# db-password`: the bundled PostgreSQL is created with them on its first start.
#
# Without it, give the existing database: its host, port, name and user, with its password in
# secrets/db_password, and remove HD_DATABASE_SSLMODE=disable so that the connection is
# verified (verify-full).
HD_DATABASE_HOST=db
#HD_DATABASE_PORT=5432
HD_DATABASE_NAME=hd
HD_DATABASE_USER=hd
HD_DATABASE_SSLMODE=disable

# The database's dumps (dumps.md): with the profile db, and with the profile dumps beside an
# existing database, a dump every day at HD_DUMPS_TIME, a time in UTC, on the volume dumps,
# which keeps the latest HD_DUMPS_KEEP. `docker compose run --rm dumps` takes one now.
#HD_DUMPS_TIME=02:30
#HD_DUMPS_KEEP=7
# The tag of the dumps' image, docker.io/library/postgres: at the database's major version or
# newer. Leave it as compose.yaml has it with the profile db; set it for an existing database
# of a later major version than 18.
#HD_DUMPS_IMAGE_TAG=18.7-trixie

# The mail servers: the mailbox the core reads, the server it sends through, and the address it
# replies from. Their URLs hold passwords, so each is a file of secrets/, named here: write the
# URL into the file, then uncomment its line. Over TLS (imaps://, smtps://) unless the server is
# on the core's own address, as the test mail server of the profile greenmail is:
#   secrets/imap_url  imap://helpdesk:helpdesk@127.0.0.1:3143/INBOX
#   secrets/smtp_url  smtp://127.0.0.1:3025
#   HD_MAIL_FROM=helpdesk@helpdesk.test
# and otherwise such as imaps://helpdesk:password@mail.example.com/INBOX and
# smtps://helpdesk:password@mail.example.com.
#HD_SECRET_IMAP_URL=./secrets/imap_url
#HD_SECRET_SMTP_URL=./secrets/smtp_url
#HD_MAIL_FROM=helpdesk@example.com
#HD_MAIL_FROM_NAME=Help desk

# The profile greenmail's ports on this host's loopback address, for sending the test mail
# server messages (SMTP) and reading the replies (IMAP).
#HD_GREENMAIL_SMTP_PORT=3025
#HD_GREENMAIL_IMAP_PORT=3143

# The profile assistant: the token and event secret that `hd addon add` printed are the files
# secrets/assistant_token and secrets/assistant_event_secret (secrets/README.md). The model
# service (addons/assistant/README.md lists the providers and the other settings), and its key,
# when it takes one, in a file of secrets/ named here.
#HD_ASSISTANT_MODEL_PROVIDER=
#HD_ASSISTANT_MODEL=
#HD_ASSISTANT_MODEL_URL=
#HD_SECRET_ASSISTANT_API_KEY=./secrets/assistant_api_key

# Signing in through an OpenID Connect provider (docs/deploy.md): the client's secret in a file
# of secrets/, named here, and its other settings below.
#HD_SECRET_OIDC_CLIENT_SECRET=./secrets/oidc_client_secret

# The core's other settings that compose.yaml passes on when they are set here, described in
# docs/deploy.md: HD_OIDC_ISSUER, HD_OIDC_CLIENT_ID, HD_OIDC_LABEL, HD_OIDC_SESSION_HOURS,
# HD_OIDC_AUTHORIZED_GROUP, HD_OIDC_GROUP_CLAIM, HD_SIGN_IN_FAILURES,
# HD_SIGN_IN_WINDOW_SECONDS, HD_IMAP_POLL_SECONDS, HD_IMAP_IMPORT_EXISTING.

# The core's log, as a tracing filter.
#HD_LOG=info,sqlx=warn

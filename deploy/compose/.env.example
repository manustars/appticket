# The install's settings: copy this file to .env beside compose.yaml and set the values.
# A line that starts with # is not set. Put a value that holds $, # or a space in single quotes:
# Compose reads $ as the start of a variable.

# What runs beside the core, separated by commas (compose.yaml describes them): db (the bundled
# PostgreSQL), assistant (the Assistant), greenmail (a test mail server). Leave db out to use an
# existing database.
COMPOSE_PROFILES=db

# The version of the images, as the release names it.
HD_VERSION=0.4.0

# The address agents open the help desk at, through the reverse proxy in front of the core.
HD_PUBLIC_URL=https://helpdesk.example.com

# Where the core is published on this host, for that proxy: the address (the loopback address
# by default) and the port.
#HD_HTTP_ADDRESS=127.0.0.1
HD_HTTP_PORT=8080

# The database (docs/external-database.md describes each setting).
#
# With the profile db, keep the host, name, user and mode below and set a password, such as one
# from `openssl rand -hex 24`: the bundled PostgreSQL is created with them on its first start.
#
# Without it, give the existing database: its host, port, name, user and password, and remove
# HD_DATABASE_SSLMODE=disable so that the connection is verified (verify-full); or replace them
# all with HD_DATABASE_URL.
HD_DATABASE_HOST=db
#HD_DATABASE_PORT=5432
HD_DATABASE_NAME=hd
HD_DATABASE_USER=hd
HD_DATABASE_PASSWORD=
HD_DATABASE_SSLMODE=disable
#HD_DATABASE_URL=postgres://helpdesk:password@db.example.com:5432/helpdesk

# The mail servers: the mailbox the core reads, the server it sends through, and the address it
# replies from. Over TLS (imaps://, smtps://) unless the server is on the core's own address, as the
# test mail server of the profile greenmail is:
#   HD_IMAP_URL=imap://helpdesk:helpdesk@127.0.0.1:3143/INBOX
#   HD_SMTP_URL=smtp://127.0.0.1:3025
#   HD_MAIL_FROM=helpdesk@helpdesk.test
#HD_IMAP_URL=imaps://helpdesk:password@mail.example.com/INBOX
#HD_SMTP_URL=smtps://helpdesk:password@mail.example.com
#HD_MAIL_FROM=helpdesk@example.com
#HD_MAIL_FROM_NAME=Help desk

# The profile greenmail's ports on this host's loopback address, for sending the test mail
# server messages (SMTP) and reading the replies (IMAP).
#HD_GREENMAIL_SMTP_PORT=3025
#HD_GREENMAIL_IMAP_PORT=3143

# The profile assistant: the token and event secret that `hd addon add` printed, and the model
# service (addons/assistant/README.md lists the providers and the other settings).
#HD_ASSISTANT_TOKEN=
#HD_ASSISTANT_EVENT_SECRET=
#HD_ASSISTANT_MODEL_PROVIDER=
#HD_ASSISTANT_MODEL=
#HD_ASSISTANT_MODEL_URL=
#HD_ASSISTANT_API_KEY=

# The core's other settings that compose.yaml passes on when they are set here, described in
# docs/deploy.md: HD_OIDC_ISSUER, HD_OIDC_CLIENT_ID, HD_OIDC_CLIENT_SECRET, HD_OIDC_LABEL,
# HD_OIDC_SESSION_HOURS, HD_OIDC_AUTHORIZED_GROUP, HD_OIDC_GROUP_CLAIM, HD_TRUSTED_PROXIES,
# HD_SIGN_IN_FAILURES, HD_SIGN_IN_WINDOW_SECONDS, HD_IMAP_POLL_SECONDS, HD_IMAP_IMPORT_EXISTING.

# The core's log, as a tracing filter.
#HD_LOG=info,sqlx=warn

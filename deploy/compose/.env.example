# The install's settings: copy this file to .env beside compose.yaml and set the values.
# A line that starts with # is not set.

# What runs beside the core, separated by commas: db (the bundled PostgreSQL). Leave db out to
# use an existing database.
COMPOSE_PROFILES=db

# The version of the images, as the release names it.
HD_VERSION=0.4.0

# The address agents open the help desk at, through the reverse proxy in front of the core.
HD_PUBLIC_URL=https://helpdesk.example.com

# Where the core is published on this host, for that proxy: the address (the loopback address
# by default) and the port.
#HD_HTTP_ADDRESS=127.0.0.1
HD_HTTP_PORT=8080

# The database (docs/external-database.md describes each setting).
#
# With the profile db, keep the host, name, user and mode below and set a password, such as one
# from `openssl rand -hex 24`: the bundled PostgreSQL is created with them on its first start.
#
# Without it, give the existing database: its host, port, name, user and password, and remove
# HD_DATABASE_SSLMODE=disable so that the connection is verified (verify-full); or replace them
# all with HD_DATABASE_URL.
HD_DATABASE_HOST=db
#HD_DATABASE_PORT=5432
HD_DATABASE_NAME=hd
HD_DATABASE_USER=hd
HD_DATABASE_PASSWORD=
HD_DATABASE_SSLMODE=disable
#HD_DATABASE_URL=postgres://helpdesk:password@db.example.com:5432/helpdesk

# The core's log, as a tracing filter.
#HD_LOG=info,sqlx=warn

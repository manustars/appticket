{
  "realm": "helpdesk",
  "displayName": "Help desk test identity provider",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": false,
  "clients": [
    {
      "clientId": "hd-core",
      "name": "Help desk (development and CI only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "redirectUris": [
        "http://127.0.0.1:8080/api/session/identity-provider/callback",
        "http://localhost:8080/api/session/identity-provider/callback",
        "http://127.0.0.1:5173/api/session/identity-provider/callback",
        "http://localhost:5173/api/session/identity-provider/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "false"
          }
        }
      ]
    }
  ],
  "groups": [
    { "name": "helpdesk-agents" }
  ],
